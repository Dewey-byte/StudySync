<?xml version="1.0" encoding="utf-8"?>
<!--
  StudySync stores academic data in an encrypted SQLite file whose key lives in
  the Android Keystore. Keystore material is never backed up, so a restored copy
  of the database would be unreadable anyway. Excluding everything makes that
  explicit and keeps the encrypted file off cloud backups and device transfers.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
